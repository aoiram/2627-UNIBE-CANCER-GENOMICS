# ==============================================================================
# Snakemake Pipeline: Somatic Variant Calling & Mutational Signatures Workflow
# Structured sequentially with numbered directories and strict data chaining.
# ==============================================================================

SAMPLES = ["normal", "tumor"]

# ------------------------------------------------------------------------------
# Fixed Reference & Resource Paths (from the IBU cluster)
# ------------------------------------------------------------------------------
BASE_DIR     = "/data/courses/cancergenomics/VAR_CALLING"
REF_FASTA    = f"{BASE_DIR}/bwa_idx/genome.fa"
INTERVALS    = f"{BASE_DIR}/reference/exome_regions.bed.interval_list"
DBSNP        = f"{BASE_DIR}/dbsnp/GCF_000001405.40_alias.vcf.gz"
KNOWN_INDELS = f"{BASE_DIR}/known_indels/resources_broad_hg38_v0_Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"
GERMLINE_RES = f"{BASE_DIR}/resources/af-only-gnomad.hg38.subset.vcf.gz"
PON          = f"{BASE_DIR}/resources/1000g_pon.hg38.subset.vcf.gz"
CLINVAR      = f"{BASE_DIR}/resources/clinvar/clinvar.vcf.gz"
VEP_CACHE    = "/data/courses/cancergenomics/2026/VEP/vep_data"

# Verify exact container filenames on the IBU cluster via: ls /containers/apptainer/
SIF_FASTQC   = "/containers/apptainer/fastqc-0.12.1.sif"
SIF_FASTP    = "/containers/apptainer/fastp_0.24.1.sif"
SIF_BWA_SAM  = "/containers/apptainer/bwa_0.7.19_samtools_1.21.sif"
SIF_GATK     = "/containers/apptainer/gatk4_4.6.2.0_samtools_1.21.sif"
SIF_MULTIQC  = "/containers/apptainer/multiqc-1.33.sif"
SIF_BCFTOOLS = "/containers/apptainer/bcftools:1.21--h8b25389_0"  # Update version if needed
SIF_VEP      = "/data/courses/cancergenomics/2026/VEP/vep.sif"        # Update version if needed

rule all:
    input:
        "02_qc/multiqc_report.html",
        "05_variants/summary.txt",
        "06_mut_signatures/somatic_6channels.svg",
        "06_mut_signatures/somatic_96channels.svg",
        "06_mut_signatures/somatic_mut_table.tsv"

# ==============================================================================
# 01 & 02: Initial QC & Pre-processing (Cleaned Data)
# ==============================================================================

rule fastqc:
    input:
        r1=f"{BASE_DIR}/fastq/{{sample}}.R1.fq.gz",
        r2=f"{BASE_DIR}/fastq/{{sample}}.R2.fq.gz"
    output:
        html1="02_qc/{sample}.R1_fastqc.html",
        html2="02_qc/{sample}.R2_fastqc.html"
    threads: 4
    singularity: SIF_FASTQC
    shell:
        """
        fastqc -t {threads} -o 02_qc {input.r1} {input.r2}
        """

rule fastp:
    input:
        r1=f"{BASE_DIR}/fastq/{{sample}}.R1.fq.gz",
        r2=f"{BASE_DIR}/fastq/{{sample}}.R2.fq.gz"
    output:
        r1="01_cleaned_data/{sample}.R1.fq.gz",
        r2="01_cleaned_data/{sample}.R2.fq.gz",
        html="02_qc/{sample}_fastp.html",
        json="02_qc/{sample}_fastp.json"
    threads: 4
    singularity: SIF_FASTP
    shell:
        """
        fastp -w {threads} \
              -i {input.r1} -I {input.r2} \
              -o {output.r1} -O {output.r2} \
              -h {output.html} -j {output.json}
        """

# ==============================================================================
# 03: Read Alignment
# ==============================================================================

rule bwa_mem_align:
    input:
        r1="01_cleaned_data/{sample}.R1.fq.gz",
        r2="01_cleaned_data/{sample}.R2.fq.gz"
    output:
        bam=temp("03_alignment/{sample}_aligned.bam")
    threads: 8
    params:
        ref=REF_FASTA,
        rg=r"@RG\tID:{sample}\tSM:{sample}\tPL:ILLUMINA"
    singularity: SIF_BWA_SAM
    shell:
        """
        bwa mem -t 6 -R '{params.rg}' {params.ref} {input.r1} {input.r2} | \
        samtools view -b -@ 2 -o {output.bam} -
        """

rule samtools_sort_index:
    input:
        bam="03_alignment/{sample}_aligned.bam"
    output:
        bam="03_alignment/{sample}_sorted.bam",
        bai="03_alignment/{sample}_sorted.bam.bai"
    threads: 8
    singularity: SIF_BWA_SAM
    shell:
        """
        samtools sort -@ {threads} {input.bam} -o {output.bam}
        samtools index -@ {threads} {output.bam}
        """

# ==============================================================================
# 04: BAM Preprocessing (MarkDuplicates & BQSR)
# ==============================================================================

rule mark_duplicates:
    input:
        bam="03_alignment/{sample}_sorted.bam",
        bai="03_alignment/{sample}_sorted.bam.bai"
    output:
        bam="04_preprocessing/{sample}_marked.bam",
        bai="04_preprocessing/{sample}_marked.bam.bai",
        metrics="02_qc/{sample}_marked_dup_metrics.txt"
    singularity: SIF_GATK
    shell:
        """
        gatk MarkDuplicates -I {input.bam} -O {output.bam} -M {output.metrics}
        samtools index {output.bam}
        """

rule baserecalibrator:
    input:
        bam="04_preprocessing/{sample}_marked.bam",
        bai="04_preprocessing/{sample}_marked.bam.bai"
    output:
        table="04_preprocessing/{sample}_recal.table"
    params:
        ref=REF_FASTA,
        dbsnp=DBSNP,
        indels=KNOWN_INDELS,
        intervals=INTERVALS
    singularity: SIF_GATK
    shell:
        """
        gatk BaseRecalibrator -R {params.ref} -I {input.bam} \
             -L {params.intervals} \
             --known-sites {params.dbsnp} \
             --known-sites {params.indels} \
             -O {output.table}
        """

rule apply_bqsr:
    input:
        bam="04_preprocessing/{sample}_marked.bam",
        bai="04_preprocessing/{sample}_marked.bam.bai",
        table="04_preprocessing/{sample}_recal.table"
    output:
        bam="04_preprocessing/{sample}_bqsr.bam",
        bai="04_preprocessing/{sample}_bqsr.bam.bai"
    params:
        ref=REF_FASTA,
        intervals=INTERVALS
    singularity: SIF_GATK
    shell:
        """
        gatk ApplyBQSR -R {params.ref} -I {input.bam} \
             -L {params.intervals} \
             --bqsr-recal-file {input.table} \
             -O {output.bam}
        samtools index {output.bam}
        """

# ==============================================================================
# 02: Post-Alignment QC Aggregation (Metrics & MultiQC)
# ==============================================================================

rule samtools_flagstat:
    input:
        bam="04_preprocessing/{sample}_bqsr.bam",
        bai="04_preprocessing/{sample}_bqsr.bam.bai"
    output:
        txt="02_qc/{sample}_flagstat.txt"
    threads: 8
    singularity: SIF_GATK
    shell:
        """
        samtools flagstat -@ {threads} {input.bam} > {output.txt}
        """

rule collect_hs_metrics:
    input:
        # Chained strictly to your pipeline's BQSR output:
        bam="04_preprocessing/{sample}_bqsr.bam",
        bai="04_preprocessing/{sample}_bqsr.bam.bai"
        # Or uncomment below to use instructor pre-aligned BAMs:
        # bam=f"{BASE_DIR}/alignments/{{sample}}.recal.bam"
    output:
        metrics="02_qc/{sample}_bqsr_hs_metrics.txt"
    params:
        ref=REF_FASTA,
        intervals=INTERVALS
    singularity: SIF_GATK
    shell:
        """
        gatk --java-options "-Xmx4G" CollectHsMetrics \
             -I {input.bam} \
             -O {output.metrics} \
             -R {params.ref} \
             --BAIT_INTERVALS {params.intervals} \
             --TARGET_INTERVALS {params.intervals}
        """

rule multiqc:
    input:
        expand("02_qc/{sample}.R1_fastqc.html", sample=SAMPLES),
        expand("02_qc/{sample}.R2_fastqc.html", sample=SAMPLES),
        expand("02_qc/{sample}_fastp.html", sample=SAMPLES),
        expand("02_qc/{sample}_marked_dup_metrics.txt", sample=SAMPLES),
        expand("02_qc/{sample}_bqsr_hs_metrics.txt", sample=SAMPLES),
        expand("02_qc/{sample}_flagstat.txt", sample=SAMPLES)
    output:
        "02_qc/multiqc_report.html"
    singularity: SIF_MULTIQC
    shell:
        """
        multiqc -f 02_qc/ -o 02_qc/ -n multiqc_report.html
        """

# ==============================================================================
# 05: Somatic Variant Calling & Filtering
# ==============================================================================

rule mutect2:
    input:
        # Chained strictly to your pipeline's BQSR BAMs:
        tumor="04_preprocessing/tumor_bqsr.bam",
        tumor_bai="04_preprocessing/tumor_bqsr.bam.bai",
        normal="04_preprocessing/normal_bqsr.bam",
        normal_bai="04_preprocessing/normal_bqsr.bam.bai"
        # Or uncomment below to use instructor pre-aligned BAMs:
        # tumor=f"{BASE_DIR}/alignments/tumor.recal.bam",
        # normal=f"{BASE_DIR}/alignments/normal.recal.bam"
    output:
        vcf="05_variants/somatic.vcf.gz",
        stats="05_variants/somatic.vcf.gz.stats"
    params:
        ref=REF_FASTA,
        intervals=INTERVALS,
        germline=GERMLINE_RES,
        pon=PON
    singularity: SIF_GATK
    shell:
        """
        gatk Mutect2 -R {params.ref} \
             --intervals {params.intervals} \
             -I {input.tumor} -I {input.normal} \
             -normal normal \
             --germline-resource {params.germline} \
             --panel-of-normals {params.pon} \
             -O {output.vcf}
        """

rule filter_mutect_calls:
    input:
        vcf="05_variants/somatic.vcf.gz",
        stats="05_variants/somatic.vcf.gz.stats"
    output:
        vcf="05_variants/somatic.filtered.vcf.gz"
    params:
        ref=REF_FASTA
    singularity: SIF_GATK
    shell:
        """
        gatk FilterMutectCalls -R {params.ref} -V {input.vcf} --stats {input.stats} -O {output.vcf}
        """

rule extract_pass_variants:
    input:
        vcf="05_variants/somatic.filtered.vcf.gz"
    output:
        vcf="05_variants/somatic.filtered.PASS.vcf.gz",
        tbi="05_variants/somatic.filtered.PASS.vcf.gz.tbi"
    singularity: SIF_BCFTOOLS
    shell:
        """
        bcftools view -f PASS {input.vcf} -Oz -o {output.vcf}
        bcftools index --tbi {output.vcf}
        """

# ==============================================================================
# 05b: Variant Annotation (VEP) & Interpretation
# ==============================================================================

rule vep_annotate:
    input:
        vcf="05_variants/somatic.filtered.PASS.vcf.gz",
        tbi="05_variants/somatic.filtered.PASS.vcf.gz.tbi"
    output:
        txt="05_variants/chr6ch17_mutect2_annotated_with_clinVar.txt"
    threads: 2
    params:
        cache=VEP_CACHE,
        clinvar=CLINVAR
    singularity: SIF_VEP
    shell:
        """
        vep -i {input.vcf} \
            --cache --dir_cache {params.cache} \
            --assembly GRCh38 \
            --species homo_sapiens \
            --offline \
            --format vcf \
            --force_overwrite \
            --fork {threads} \
            --everything \
            --custom {params.clinvar},ClinVar,vcf,exact,0,CLNSIG,CLNREVSTAT,CLNDN \
            --output_file {output.txt} \
        """

rule filter_vep:
    input:
        txt="05_variants/chr6ch17_mutect2_annotated_with_clinVar.txt"
    output:
        txt="05_variants/chr6ch17_mutect2_annotated_with_clinVar_filtered.txt"
    singularity: SIF_VEP
    shell:
        """
        filter_vep -i {input.txt} -o {output.txt} \
            --force_overwrite \
            --filter "(IMPACT is HIGH or IMPACT is MODERATE) or \
                      (SIFT match deleterious or PolyPhen match probably_damaging) or \
                      (ClinVar_CLNSIG match pathogenic)"
        """

rule summarize_variants:
    input:
        txt="05_variants/chr6ch17_mutect2_annotated_with_clinVar_filtered.txt"
    output:
        txt="05_variants/summary.txt"
    shell:
        """
        echo "Mutation Type Summary:" > {output.txt}
        grep -v "^#" {input.txt} | cut -f7 | sort | uniq -c >> {output.txt}
        """

# ==============================================================================
# 06: Mutational Signatures (From Provided Lecture Slides)
# ==============================================================================

rule prepare_trinuc_table:
    """
    Extracts SNVs from the PASS VCF, queries +/- 1bp context via samtools faidx
    as shown in the Mutational Signatures slides, and outputs REF, ALT, TRINUC.
    """
    input:
        vcf="05_variants/somatic.filtered.PASS.vcf.gz",
        ref=REF_FASTA
    output:
        tsv="06_mut_signatures/somatic_vcf_mut.tsv"
    singularity: SIF_BWA_SAM
    shell:
        r"""
        echo -e "REF\tALT\tTRINUC" > {output.tsv}
        zgrep -v "^#" {input.vcf} | awk 'length($4)==1 && length($5)==1 {{print $1, $2, $4, $5}}' | \
        while read chr pos ref alt; do
            start=$((pos - 1))
            end=$((pos + 1))
            trinuc=$(samtools faidx {input.ref} "${{chr}}:${{start}}-${{end}}" | tail -n 1 | tr 'a-z' 'A-Z')
            echo -e "${{ref}}\t${{alt}}\t${{trinuc}}" >> {output.tsv}
        done
        """

rule plot_mutational_channels:
    """
    Generates the 6-channel and 96-channel plots and count matrix (for MutationalPatterns)
    directly using the Python logic from the Mutational Signatures slides.
    """
    input:
        tsv="06_mut_signatures/somatic_vcf_mut.tsv"
    output:
        plot6="06_mut_signatures/somatic_6channels.svg",
        plot96="06_mut_signatures/somatic_96channels.svg",
        table96="06_mut_signatures/somatic_mut_table.tsv"
    conda:
        "envs/plotting.yaml"
    shell:
        "env PYTHONPATH='' ~/.venvs/plotting/bin/python scripts/plotting.py"