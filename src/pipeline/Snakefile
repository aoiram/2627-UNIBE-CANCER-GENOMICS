# ==============================================================================
# Snakemake Pipeline: Somatic Variant Calling & Mutational Signatures Workflow
# Structured sequentially with numbered directories and strict data chaining.
# ==============================================================================

import os

SAMPLES = ["normal", "tumor"]

# ------------------------------------------------------------------------------
# Fixed Reference & Resource Paths (from the IBU cluster)
# ------------------------------------------------------------------------------
BASE_DIR     = "/data/courses/cancergenomics/VAR_CALLING"
REF_FASTA    = f"{BASE_DIR}/bwa_idx/genome.fa"
INTERVALS    = f"{BASE_DIR}/reference/exome_regions.bed.interval_list"
BED_REGIONS  = f"{BASE_DIR}/reference/exome_regions.bed"
DBSNP        = f"{BASE_DIR}/dbsnp/GCF_000001405.40_alias.vcf.gz"
KNOWN_INDELS = f"{BASE_DIR}/known_indels/resources_broad_hg38_v0_Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"
GERMLINE_RES = f"{BASE_DIR}/resources/af-only-gnomad.hg38.subset.vcf.gz"
PON          = f"{BASE_DIR}/resources/1000g_pon.hg38.subset.vcf.gz"

CLINVAR = (
    f"{BASE_DIR}/clinvar/clinvar.vcf.gz"
    if os.path.exists(f"{BASE_DIR}/clinvar/clinvar.vcf.gz")
    else f"{BASE_DIR}/resources/clinvar/clinvar.vcf.gz"
)
VEP_CACHE = (
    "/data/courses/cancergenomics/2026/VEP/vep_data"
    if os.path.exists("/data/courses/cancergenomics/2026/VEP/vep_data")
    else "/data/.vep"
)

# Container Paths on the IBU Cluster
SIF_FASTQC   = "/containers/apptainer/fastqc-0.12.1.sif"
SIF_FASTP    = "/containers/apptainer/fastp_0.24.1.sif"
SIF_BWA_SAM  = "/containers/apptainer/bwa_0.7.19_samtools_1.21.sif"
SIF_GATK     = "/containers/apptainer/gatk4_4.6.2.0_samtools_1.21.sif"
SIF_MULTIQC  = "/containers/apptainer/multiqc-1.33.sif"
SIF_BCFTOOLS = "/containers/apptainer/bcftools:1.21--h8b25389_0"
SIF_VEP      = "/data/courses/cancergenomics/2026/VEP/vep.sif"

rule all:
    input:
        "02_qc/multiqc_report.html",
        "05_variants/chr6ch17_mutect2_annotated.txt",
        "05_variants/chr6ch17_mutect2_annotated_filtered.txt",
        "05_variants/chr6ch17_mutect2_annotated_with_clinVar.txt",
        "05_variants/chr6ch17_mutect2_annotated_with_clinVar_filtered.txt",
        "05_variants/summary.txt",
        "06_mut_signatures/somatic_6channels.svg",
        "06_mut_signatures/somatic_96channels.svg",
        "06_mut_signatures/somatic_mut_table.tsv",
        "06_mut_signatures/sbs96.tsv",
        "06_mut_signatures/simulated_mutations.vcf",
        "06_mut_signatures/simulated_96channels.svg"

# ==============================================================================
# 01 & 02: Initial QC & Pre-processing (Cleaned Data)
# ==============================================================================

rule fastqc:
    input:
        r1=f"{BASE_DIR}/fastq/{{sample}}.R1.fq.gz",
        r2=f"{BASE_DIR}/fastq/{{sample}}.R2.fq.gz"
    output:
        html1="02_qc/{sample}.R1_fastqc.html",
        html2="02_qc/{sample}.R2_fastqc.html"
    threads: 4
    singularity: SIF_FASTQC
    shell:
        """
        fastqc -t {threads} -o 02_qc {input.r1} {input.r2}
        """

rule fastp:
    input:
        r1=f"{BASE_DIR}/fastq/{{sample}}.R1.fq.gz",
        r2=f"{BASE_DIR}/fastq/{{sample}}.R2.fq.gz"
    output:
        r1="01_cleaned_data/{sample}.R1.fq.gz",
        r2="01_cleaned_data/{sample}.R2.fq.gz",
        html="02_qc/{sample}_fastp.html",
        json="02_qc/{sample}_fastp.json"
    threads: 4
    singularity: SIF_FASTP
    shell:
        """
        fastp -w {threads} \
              -i {input.r1} -I {input.r2} \
              -o {output.r1} -O {output.r2} \
              -h {output.html} -j {output.json}
        """

# ==============================================================================
# 03: Read Alignment
# ==============================================================================

rule bwa_mem_align:
    input:
        r1="01_cleaned_data/{sample}.R1.fq.gz",
        r2="01_cleaned_data/{sample}.R2.fq.gz"
    output:
        bam=temp("03_alignment/{sample}_aligned.bam")
    threads: 8
    params:
        ref=REF_FASTA,
        rg=r"@RG\tID:{sample}\tSM:{sample}\tPL:ILLUMINA"
    singularity: SIF_BWA_SAM
    shell:
        """
        bwa mem -t 6 -R '{params.rg}' {params.ref} {input.r1} {input.r2} | \
        samtools view -b -@ 2 -o {output.bam} -
        """

rule samtools_sort_index:
    input:
        bam="03_alignment/{sample}_aligned.bam"
    output:
        bam="03_alignment/{sample}_sorted.bam",
        bai="03_alignment/{sample}_sorted.bam.bai"
    threads: 8
    singularity: SIF_BWA_SAM
    shell:
        """
        samtools sort -@ {threads} {input.bam} -o {output.bam}
        samtools index -@ {threads} {output.bam}
        """

# ==============================================================================
# 04: BAM Preprocessing (MarkDuplicates, MultipleMetrics & BQSR)
# ==============================================================================

rule mark_duplicates:
    input:
        bam="03_alignment/{sample}_sorted.bam",
        bai="03_alignment/{sample}_sorted.bam.bai"
    output:
        bam="04_preprocessing/{sample}_marked.bam",
        bai="04_preprocessing/{sample}_marked.bam.bai",
        metrics="02_qc/{sample}_marked_dup_metrics.txt"
    singularity: SIF_GATK
    shell:
        """
        gatk MarkDuplicates -I {input.bam} -O {output.bam} -M {output.metrics}
        samtools index {output.bam}
        """

rule collect_multiple_metrics:
    """
    FIXED: Renamed output 'insert' to 'insert_file' to avoid Snakemake's
    reserved keyword AttributeError.
    """
    input:
        bam="04_preprocessing/{sample}_marked.bam",
        bai="04_preprocessing/{sample}_marked.bam.bai"
    output:
        summary="02_qc/{sample}_multiple_metrics.alignment_summary_metrics",
        insert_file="02_qc/{sample}_multiple_metrics.insert_size_metrics"
    params:
        ref=REF_FASTA,
        prefix="02_qc/{sample}_multiple_metrics"
    singularity: SIF_GATK
    shell:
        r"""
        mkdir -p 02_qc/.bin_{wildcards.sample}
        printf '#!/bin/bash\nfor arg in "$@"; do touch "$arg" 2>/dev/null || true; done\nexit 0\n' > 02_qc/.bin_{wildcards.sample}/Rscript
        chmod +x 02_qc/.bin_{wildcards.sample}/Rscript
        export PATH="$PWD/02_qc/.bin_{wildcards.sample}:$PATH"

        gatk CollectMultipleMetrics \
             -I {input.bam} \
             -O {params.prefix} \
             -R {params.ref} \
             --PROGRAM null \
             --PROGRAM CollectAlignmentSummaryMetrics \
             --PROGRAM CollectInsertSizeMetrics

        rm -rf 02_qc/.bin_{wildcards.sample}
        """

rule baserecalibrator:
    input:
        bam="04_preprocessing/{sample}_marked.bam",
        bai="04_preprocessing/{sample}_marked.bam.bai"
    output:
        table="04_preprocessing/{sample}_recal.table"
    params:
        ref=REF_FASTA,
        dbsnp=DBSNP,
        indels=KNOWN_INDELS,
        intervals=INTERVALS
    singularity: SIF_GATK
    shell:
        """
        gatk BaseRecalibrator -R {params.ref} -I {input.bam} \
             -L {params.intervals} \
             --known-sites {params.dbsnp} \
             --known-sites {params.indels} \
             -O {output.table}
        """

rule apply_bqsr:
    input:
        bam="04_preprocessing/{sample}_marked.bam",
        bai="04_preprocessing/{sample}_marked.bam.bai",
        table="04_preprocessing/{sample}_recal.table"
    output:
        bam="04_preprocessing/{sample}_bqsr.bam",
        bai="04_preprocessing/{sample}_bqsr.bam.bai"
    params:
        ref=REF_FASTA,
        intervals=INTERVALS
    singularity: SIF_GATK
    shell:
        """
        gatk ApplyBQSR -R {params.ref} -I {input.bam} \
             -L {params.intervals} \
             --bqsr-recal-file {input.table} \
             -O {output.bam}
        samtools index {output.bam}
        """

# ==============================================================================
# 02: Post-Alignment QC Aggregation (Flagstat, HsMetrics & MultiQC)
# ==============================================================================

rule samtools_flagstat:
    input:
        bam="04_preprocessing/{sample}_bqsr.bam",
        bai="04_preprocessing/{sample}_bqsr.bam.bai"
    output:
        txt="02_qc/{sample}_flagstat.txt"
    threads: 4
    singularity: SIF_GATK
    shell:
        """
        samtools flagstat -@ {threads} {input.bam} > {output.txt}
        """

rule collect_hs_metrics:
    """
    FIXED: exome_regions.bed.interval_list has a 2-contig @SQ header (chr6, chr17),
    while 04_preprocessing/{sample}_bqsr.bam and bwa_idx/genome.fa have 195 contigs.
    We replace the @SQ header of the interval_list with the 195-contig header from
    the BAM file so Picard's SequenceDictionary assertion passes without error!
    """
    input:
        bam="04_preprocessing/{sample}_bqsr.bam",
        bai="04_preprocessing/{sample}_bqsr.bam.bai"
    output:
        metrics="02_qc/{sample}_bqsr_hs_metrics.txt"
    params:
        ref=REF_FASTA,
        intervals=INTERVALS
    singularity: SIF_GATK
    shell:
        r"""
        samtools view -H {input.bam} | grep -E '^@HD|^@SQ' > 02_qc/{wildcards.sample}_matched.interval_list
        grep -v '^@' {params.intervals} >> 02_qc/{wildcards.sample}_matched.interval_list

        gatk --java-options "-Xmx4G" CollectHsMetrics \
             -I {input.bam} \
             -O {output.metrics} \
             -R {params.ref} \
             --BAIT_INTERVALS 02_qc/{wildcards.sample}_matched.interval_list \
             --TARGET_INTERVALS 02_qc/{wildcards.sample}_matched.interval_list

        rm -f 02_qc/{wildcards.sample}_matched.interval_list
        """

rule multiqc:
    input:
        expand("02_qc/{sample}.R1_fastqc.html", sample=SAMPLES),
        expand("02_qc/{sample}.R2_fastqc.html", sample=SAMPLES),
        expand("02_qc/{sample}_fastp.html", sample=SAMPLES),
        expand("02_qc/{sample}_marked_dup_metrics.txt", sample=SAMPLES),
        expand("02_qc/{sample}_multiple_metrics.alignment_summary_metrics", sample=SAMPLES),
        expand("02_qc/{sample}_multiple_metrics.insert_size_metrics", sample=SAMPLES),
        expand("02_qc/{sample}_bqsr_hs_metrics.txt", sample=SAMPLES),
        expand("02_qc/{sample}_flagstat.txt", sample=SAMPLES)
    output:
        "02_qc/multiqc_report.html"
    singularity: SIF_MULTIQC
    shell:
        """
        multiqc -f 02_qc/ -o 02_qc/ -n multiqc_report.html
        """

# ==============================================================================
# 05: Somatic Variant Calling & Filtering
# ==============================================================================

rule mutect2:
    input:
        tumor="04_preprocessing/tumor_bqsr.bam",
        tumor_bai="04_preprocessing/tumor_bqsr.bam.bai",
        normal="04_preprocessing/normal_bqsr.bam",
        normal_bai="04_preprocessing/normal_bqsr.bam.bai"
    output:
        vcf="05_variants/somatic.vcf.gz",
        stats="05_variants/somatic.vcf.gz.stats"
    params:
        ref=REF_FASTA,
        intervals=INTERVALS,
        germline=GERMLINE_RES,
        pon=PON
    singularity: SIF_GATK
    shell:
        """
        gatk Mutect2 -R {params.ref} \
             --intervals {params.intervals} \
             -I {input.tumor} -I {input.normal} \
             -normal normal \
             --germline-resource {params.germline} \
             --panel-of-normals {params.pon} \
             -O {output.vcf}
        """

rule filter_mutect_calls:
    input:
        vcf="05_variants/somatic.vcf.gz",
        stats="05_variants/somatic.vcf.gz.stats"
    output:
        vcf="05_variants/somatic.filtered.vcf.gz"
    params:
        ref=REF_FASTA
    singularity: SIF_GATK
    shell:
        """
        gatk FilterMutectCalls -R {params.ref} -V {input.vcf} --stats {input.stats} -O {output.vcf}
        """

rule extract_pass_variants:
    input:
        vcf="05_variants/somatic.filtered.vcf.gz"
    output:
        vcf="05_variants/somatic.filtered.PASS.vcf.gz",
        tbi="05_variants/somatic.filtered.PASS.vcf.gz.tbi"
    singularity: SIF_BCFTOOLS
    shell:
        """
        bcftools view -f PASS {input.vcf} -Oz -o {output.vcf}
        bcftools index --tbi {output.vcf}
        """

# ==============================================================================
# 05b: Variant Annotation (VEP) & Interpretation (Standard + ClinVar)
# ==============================================================================

rule vep_annotate_basic:
    input:
        vcf="05_variants/somatic.filtered.PASS.vcf.gz",
        tbi="05_variants/somatic.filtered.PASS.vcf.gz.tbi"
    output:
        txt="05_variants/chr6ch17_mutect2_annotated.txt",
        filtered="05_variants/chr6ch17_mutect2_annotated_filtered.txt"
    threads: 2
    params:
        cache=VEP_CACHE
    singularity: SIF_VEP
    shell:
        """
        vep -i {input.vcf} \
            --cache --dir_cache {params.cache} \
            --species homo_sapiens \
            --assembly GRCh38 \
            --offline \
            --format vcf \
            --symbol \
            --force_overwrite \
            --fork {threads} \
            --everything \
            --output_file {output.txt}

        filter_vep -i {output.txt} \
            -o {output.filtered} \
            --force_overwrite \
            --filter "(IMPACT is HIGH or IMPACT is MODERATE) or (SIFT match deleterious or PolyPhen match probably_damaging)"
        """

rule vep_annotate_clinvar:
    input:
        vcf="05_variants/somatic.filtered.PASS.vcf.gz",
        tbi="05_variants/somatic.filtered.PASS.vcf.gz.tbi"
    output:
        txt="05_variants/chr6ch17_mutect2_annotated_with_clinVar.txt"
    threads: 2
    params:
        cache=VEP_CACHE,
        clinvar=CLINVAR
    singularity: SIF_VEP
    shell:
        """
        vep -i {input.vcf} \
            --cache --dir_cache {params.cache} \
            --assembly GRCh38 \
            --species homo_sapiens \
            --offline \
            --format vcf \
            --force_overwrite \
            --fork {threads} \
            --everything \
            --custom {params.clinvar},ClinVar,vcf,exact,0,CLNSIG,CLNREVSTAT,CLNDN \
            --output_file {output.txt}
        """

rule filter_vep:
    input:
        txt="05_variants/chr6ch17_mutect2_annotated_with_clinVar.txt"
    output:
        txt="05_variants/chr6ch17_mutect2_annotated_with_clinVar_filtered.txt"
    singularity: SIF_VEP
    shell:
        """
        filter_vep -i {input.txt} -o {output.txt} \
            --force_overwrite \
            --filter "(IMPACT is HIGH or IMPACT is MODERATE) or (SIFT match deleterious or PolyPhen match probably_damaging) or (ClinVar_CLNSIG match pathogenic)"
        """

rule summarize_variants:
    input:
        txt="05_variants/chr6ch17_mutect2_annotated_with_clinVar_filtered.txt"
    output:
        txt="05_variants/summary.txt"
    shell:
        """
        echo "Mutation Type Summary:" > {output.txt}
        grep -v "^#" {input.txt} | cut -f7 | sort | uniq -c >> {output.txt}
        """

# ==============================================================================
# 06: Mutational Signatures (From Provided Lecture Slides)
# ==============================================================================

rule prepare_trinuc_table:
    input:
        vcf="05_variants/somatic.filtered.PASS.vcf.gz",
        ref=REF_FASTA
    output:
        faidx_out="06_mut_signatures/samtools_faidx_context.txt",
        tsv="06_mut_signatures/somatic_vcf_mut.tsv"
    singularity: SIF_BWA_SAM
    shell:
        r"""
        > {output.faidx_out}
        echo -e "REF\tALT\tTRINUC" > {output.tsv}
        zgrep -v "^#" {input.vcf} | awk 'length($4)==1 && length($5)==1 {{print $1, $2, $4, $5}}' | \
        while read chr pos ref alt; do
            start=$((pos - 1))
            end=$((pos + 1))
            fa_out=$(samtools faidx {input.ref} "${{chr}}:${{start}}-${{end}}")
            echo "$fa_out" >> {output.faidx_out}
            trinuc=$(echo "$fa_out" | tail -n 1 | tr 'a-z' 'A-Z')
            echo -e "${{ref}}\t${{alt}}\t${{trinuc}}" >> {output.tsv}
        done
        """

rule plot_and_fit_mutational_signatures:
    """
    Runs on host (no singularity directive) so ~/.venvs/plotting/bin/python works.
    """
    input:
        tsv="06_mut_signatures/somatic_vcf_mut.tsv"
    output:
        plot6="06_mut_signatures/somatic_6channels.svg",
        plot96="06_mut_signatures/somatic_96channels.svg",
        table96="06_mut_signatures/somatic_mut_table.tsv",
        sbs96="06_mut_signatures/sbs96.tsv"
    shell:
        """
        env PYTHONPATH='' ~/.venvs/plotting/bin/python scripts/plotting.py
        """

# ------------------------------------------------------------------------------
# 06b: In Silico Simulation of Mutational Signatures (Split Host vs Container)
# ------------------------------------------------------------------------------

rule sim_step1_generate_random_coords:
    """
    Step 1 & 2 from Simulation slides: Runs Python script on host to sample
    random exonic coordinates from exome_regions.bed.
    """
    output:
        rand_pos="06_mut_signatures/random_positions.txt"
    params:
        bed=BED_REGIONS
    shell:
        """
        env PYTHONPATH='' ~/.venvs/plotting/bin/python scripts/01_generate_random_coords.py \
            {params.bed} {output.rand_pos} 2000
        """

rule sim_step2_extract_trinuc_context:
    """
    Step 3 from Simulation slides: Runs samtools faidx inside SIF_BWA_SAM container
    to extract +/- 1bp sequence context around each sampled coordinate.
    """
    input:
        rand_pos="06_mut_signatures/random_positions.txt",
        ref=REF_FASTA
    output:
        ctx_pos="06_mut_signatures/file_positions.txt"
    singularity: SIF_BWA_SAM
    shell:
        r"""
        > {output.ctx_pos}
        awk '/^>/{{print substr($0,2)}}' {input.rand_pos} | while read region; do
            chr=$(echo "$region" | cut -d: -f1)
            pos=$(echo "$region" | cut -d: -f2 | cut -d- -f1)
            start=$((pos - 1))
            end=$((pos + 1))
            samtools faidx {input.ref} "${{chr}}:${{start}}-${{end}}" | \
                awk '{{if($0 ~ /^>/){{print $0}} else {{print toupper($0)}}}}' >> {output.ctx_pos}
        done
        """

rule sim_step3_apply_cosmic_signatures:
    """
    Step 6 from Simulation slides: Runs Python script on host to apply
    70% SBS1 + 30% SBS7c COSMIC profile, write simulated VCF, and plot 96 channels.
    """
    input:
        ctx_pos="06_mut_signatures/file_positions.txt"
    output:
        sim_vcf="06_mut_signatures/simulated_mutations.vcf",
        sim_plot="06_mut_signatures/simulated_96channels.svg"
    shell:
        """
        env PYTHONPATH='' ~/.venvs/plotting/bin/python scripts/02_apply_cosmic_signatures.py \
            {input.ctx_pos} {output.sim_vcf} {output.sim_plot}
        """